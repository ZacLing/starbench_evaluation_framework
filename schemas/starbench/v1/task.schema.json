{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v1/task.schema.json",
  "title": "StarBench task.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "rubrics": {
      "type": "string"
    },
    "human_reference": {
      "type": "string"
    },
    "rigors": {
      "type": "string"
    },
    "executor_skills": {
      "type": ["string", "null"]
    },
    "subtle_difference": {
      "type": "string"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "allow_web_search": {
      "type": "boolean"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_dir": {
      "type": ["string", "null"]
    }
  },
  "required": ["id"]
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v1/task_summary.schema.json",
  "title": "StarBench task summary",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_task_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "instruction_mode": {
      "type": "string"
    },
    "instruction_variant": {
      "type": "string"
    },
    "executor_timing": {
      "type": ["object", "null"]
    },
    "executor": {
      "type": "object"
    },
    "judges": {
      "type": "object"
    }
  },
  "required": ["run_task_id", "task_id", "executor", "judges"]
}


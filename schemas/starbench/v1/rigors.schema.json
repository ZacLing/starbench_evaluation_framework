{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v1/rigors.schema.json",
  "title": "StarBench rigors.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "rigors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "rubric_id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          }
        },
        "required": ["id", "requirement"]
      }
    }
  },
  "required": ["rigors"]
}


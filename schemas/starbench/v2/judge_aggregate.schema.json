{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v2/judge_aggregate.schema.json",
  "title": "StarBench judge aggregate v2",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [2]
    },
    "mode": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "agent_pass",
        "agent_fail",
        "inconclusive_judge",
        "inconclusive_executor",
        "invalid_task"
      ]
    },
    "overall_pass": {
      "type": ["boolean", "null"]
    },
    "passed_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_count": {
      "type": "integer",
      "minimum": 0
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fail_fast_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "rubric_id": {
            "type": "string"
          },
          "answer": {
            "type": ["boolean", "null"]
          },
          "expected": {
            "type": "boolean"
          },
          "passed": {
            "type": ["boolean", "null"]
          },
          "fail_fast": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": ["rubric_id", "answer", "expected", "passed", "fail_fast", "evidence"]
      }
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "outcome",
    "overall_pass",
    "passed_count",
    "total_count",
    "missing",
    "fail_fast_failures",
    "results"
  ]
}

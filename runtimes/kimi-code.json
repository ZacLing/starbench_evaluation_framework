{
  "id": "kimi-code",
  "label": "Kimi Code CLI",
  "description": "Moonshot AI's coding agent",
  "icon": "kimi",
  "command": "kimi",
  "args": [
    "--print",
    "--output-format",
    "text",
    "--final-message-only"
  ],
  "prompt_via": "stdin",
  "parser": "text",
  "protocol": "openai",
  "base_url_env": "OPENAI_BASE_URL",
  "api_key_env": "OPENAI_API_KEY",
  "docker": {
    "image": "starbench-kimi:latest",
    "env_passthrough": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v1/task_summary.schema.json",
  "title": "StarBench task summary",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "run_task_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "agent_pass",
        "agent_fail",
        "inconclusive_judge",
        "inconclusive_executor",
        "invalid_task"
      ]
    },
    "instruction_mode": {
      "type": "string"
    },
    "instruction_variant": {
      "type": "string"
    },
    "advisory_executor_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advisory_executor_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "required_executor_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_executor_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "executor_timing": {
      "type": ["object", "null"]
    },
    "executor": {
      "type": "object"
    },
    "judges": {
      "type": "object"
    }
  },
  "required": ["run_task_id", "task_id", "executor", "judges"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starbench.dev/schemas/v1/executor_skills.schema.json",
  "title": "StarBench executor_skills.json",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
            "maxLength": 512
          },
          "activation": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "leakage_level": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": ["id"]
      }
    }
  },
  "required": ["skills"]
}
